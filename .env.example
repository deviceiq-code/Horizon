# Copy to .env and fill in. The .env file must NEVER be committed.
# False whenever other machines can reach the dev servers: Django's debug pages show the
# environment (database password included)
DEBUG=True
SECRET_KEY=replace-with-a-long-random-key
# Names the site may be opened by (Django and the Vite dev server read this list); add the
# address other machines use, e.g. 192.168.1.100 or horizon.example.com (* = any)
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host + port) the browser sends forms from, e.g.
# http://192.168.1.100:5173 or https://horizon.example.com. Behind a reverse proxy with HTTPS
# (Nginx Proxy Manager…) list the address exactly as in the browser, with the proxy's public
# port when it is not 443 (e.g. https://horizon.example.com:8443); otherwise every save fails
# with a 403 "CSRF Failed: Origin checking failed" (see README)
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Where the Vite dev server listens: localhost (this machine only) or 0.0.0.0 (other machines:
# local network, or the internet through a tunnel / port forwarding — tests only)
# DEV_LISTEN_HOST=0.0.0.0
# Special characters in the password must be URL-encoded (e.g. @ -> %40)
DATABASE_URL=postgres://horizon:PASSWORD@TrueNAS-1:5432/horizon_dev
# Where uploaded files are stored (default: backend/media) and the size limit per document.
# Machines sharing the same database must share this folder too (photos answer 404 otherwise)
# MEDIA_ROOT=/srv/horizon/media
# PRICE_DOCUMENT_MAX_MB=25
